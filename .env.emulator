# Modo "emulator": npm run dev:emu / npm run build:emu
# Projeto "demo-*": o Firebase CLI roda tudo localmente, sem conta e sem nuvem.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-exodo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-exodo
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
