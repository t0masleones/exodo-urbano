# Copie para ".env.production.local" (ou ".env.local" em desenvolvimento) e preencha.
# Arquivos *.local não vão para o git.
#
# Nada aqui é segredo: a configuração web do Firebase é pública por natureza
# (vai dentro do app). A segurança vem das regras do Firestore, do App Check
# e das restrições da chave de API no Google Cloud (docs/SEGURANCA.md).
# Sem estas variáveis o jogo funciona 100% offline, sem contas.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check na web (reCAPTCHA Enterprise). Opcional no início, obrigatório antes de lançar.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Login com Apple também na versão web (no iOS ele aparece sempre).
VITE_AUTH_APPLE_WEB=false

# Endereço público do site (páginas legais), usado nas lojas.
VITE_PUBLIC_SITE_URL=

# true = usa os emuladores locais do Firebase (npm run emulators).
VITE_USE_EMULATORS=false
